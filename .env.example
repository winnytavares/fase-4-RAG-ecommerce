# Chave da API do Google Gemini (usada no Databricks e localmente)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Configurações opcionais de Databricks / MLflow
DATABRICKS_HOST=https://seu-workspace.cloud.databricks.com
DATABRICKS_TOKEN=seu_token_databricks_aqui
DELTA_TABLE_NAME=workspace.default.reviews_rag

# Parâmetros do Pipeline RAG & Guardrail
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_MODEL=gemini-2.5-flash
GUARDRAIL_MIN_SIMILARITY=0.30
TOP_K_DOCUMENTS=4
