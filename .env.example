# Configurações de API e Credenciais
# Copie este arquivo para .env e informe suas chaves privadas

# Google Gemini API Key (Obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Databricks Configurações (Opcional - caso execute fora do cluster)
# DATABRICKS_HOST=https://seu-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=seu_token_databricks
